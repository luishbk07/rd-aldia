# Copy these into the Netlify UI (Site configuration → Environment variables).
# Do not commit real secrets. .env.local stays local.

ADMIN_USERNAME=luis
ADMIN_PASSWORD=change-me-to-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-characters

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared bearer for /api/cron/* and Netlify scheduled functions (backend-only).
# MLB */15, weather */30, currency hourly, fuel Friday 18:00 UTC, news */15.
CRON_SECRET=replace-with-a-long-random-token

# Public site URL for canonicals, sitemap, and schema.org
NEXT_PUBLIC_SITE_URL=https://rdaldia.com

# Sanity CMS (Studio at /studio). Project ID is public: sanity.io/manage → project.
# Copy this file to .env.local (gitignored). Restart npm run dev after changing it.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-03
# Optional. Lets drafts show in local `next dev`. Never required in production.
SANITY_API_READ_TOKEN=
# Write token (Editor) for `npm run migrate:all` (culture + destinations).
# Create at https://www.sanity.io/manage → API → Tokens. Do not commit this value.
SANITY_API_WRITE_TOKEN=

# AdSense. Client ID is public. Leave slot IDs empty until Google approves units.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7362041124232949
NEXT_PUBLIC_ADS_ENABLED=1

# Optional analytics. Prefer Plausible (no cookies). GA4 is opt-in.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# GA4 measurement ID (G-XXXXXXXX). NEXT_PUBLIC_ is required in the browser.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_MEASUREMENT_ID=
# Google Ads conversion send_to, e.g. AW-XXXX/label
NEXT_PUBLIC_ADS_CONVERSION_ID=

# Optional. exchangerate.host now requires a key; without it we fall back.
EXCHANGERATE_HOST_KEY=

# Contact form (Formspree). Create a form at formspree.io and paste the id.
# Example endpoint: https://formspree.io/f/xxxxxxxx → id is xxxxxxxx
NEXT_PUBLIC_FORMSPREE_ID=
